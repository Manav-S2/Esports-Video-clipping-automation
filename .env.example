# Environment variables read by the pipeline. Copy to `.env` (git-ignored) or set in
# your shell. Every variable is optional unless the feature that reads it is enabled;
# most have config-file equivalents (see live_pipeline_config.example.json).

# --- Gemini (round detection, highlight vision review) ---
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash
GOOGLE_API_KEY=                      # generic Google API key fallback

# --- Vertex AI (highlight scoring backend) ---
VERTEX_API_KEY=
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1
GOOGLE_CLOUD_PROJECT=                # ADC project (alternative to VERTEX_PROJECT_ID)
GCLOUD_PROJECT=                      # legacy alias, same as above

# --- Google Cloud Speech-to-Text (karaoke captions) ---
GOOGLE_SPEECH_API_KEY=               # REST key path; ADC path uses GOOGLE_APPLICATION_CREDENTIALS

# --- NVIDIA NIM (model-evaluation harnesses) ---
NVIDIA_API_KEY=
CLIP4_NVIDIA_API_KEY=                # separate key for the clip4/clip5 eval scripts

# --- AWS (optional S3 upload; aws_credentials.local.json also works) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=

# --- Instagram posting (optional; keep instagram_enabled false until dry-runs pass) ---
INSTA_USER=
INSTA_PASS=

# --- Captions integration overrides ---
CAPTIONS_BURN_SCRIPT=                # path override for the karaoke burn script
CAPTIONS_KARAOKE_ROOT=               # root folder for karaoke caption assets

# --- Misc ---
HIGHLIGHT_RULES_DOCX=                # path to the editorial rules .docx for audio-only scoring
SSL_CERT_FILE=                       # custom CA bundle (defaults to certifi)
